# Fundação MIG-R2 — placeholders para o Supabase LOCAL (Docker). Nunca aponte estas variáveis
# para um projeto Supabase remoto: o guard em src/lib/isolation-guard.ts recusa qualquer valor
# que não seja localhost/127.0.0.1.
#
# Copie para .env.local e preencha com os valores impressos por `npx supabase start`
# (ver docs/supabase-local.md).

# URL pública da API local do Supabase. Exposta ao navegador (NEXT_PUBLIC_*): deve permanecer
# restrita a http://127.0.0.1:<porta> ou http://localhost:<porta>.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:40201

# Chave anônima (anon key) do stack local. É pública por design no Supabase, mas ainda assim
# deve ser a chave fixa de desenvolvimento local, nunca a de um projeto remoto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Chave de service role do stack local. NUNCA prefixar com NEXT_PUBLIC_*: uso restrito ao
# servidor (rotas de API / Server Components), nunca enviada ao navegador.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
